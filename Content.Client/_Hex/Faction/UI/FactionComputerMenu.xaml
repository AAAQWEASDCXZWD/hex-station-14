<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      SetSize="680 520"
                      MinSize="620 480">
    <BoxContainer Orientation="Horizontal" Margin="0" SeparationOverride="0">
        <!-- Light panel (left, wider): creation + claimed faction profile. -->
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#d9e2ec" BorderColor="#b0bec5" BorderThickness="1" ContentMarginLeftOverride="12" ContentMarginRightOverride="12" ContentMarginTopOverride="10" ContentMarginBottomOverride="10"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                <Label Text="{Loc 'faction-computer-menu-title'}" StyleClasses="LabelBig" FontColorOverride="#1e293b" Margin="0 0 0 2"/>

                <!-- Shown until the terminal has been claimed by a faction. -->
                <BoxContainer Name="RegisterContainer" Orientation="Vertical" SeparationOverride="4">
                    <Label Text="{Loc 'faction-computer-register-hint'}" StyleClasses="LabelSubText" FontColorOverride="#334155"/>
                    <Button Name="IdCardButton" Text="{Loc 'faction-computer-id-insert'}" HorizontalExpand="True" MinSize="0 26"/>
                    <Label Name="IdCardStatus" Text="{Loc 'faction-computer-id-empty'}" StyleClasses="LabelSubText" FontColorOverride="#334155"/>
                    <LineEdit Name="NameEdit" PlaceHolder="{Loc 'faction-computer-register-name'}" HorizontalExpand="True" MinSize="0 26"/>
                    <Button Name="CreateButton" Text="{Loc 'faction-computer-register-create'}" Disabled="True" HorizontalExpand="True" MinSize="0 28"/>
                    <Label Text="{Loc 'faction-computer-register-note'}" StyleClasses="LabelSubText" FontColorOverride="#334155" Margin="0 2 0 0"/>
                </BoxContainer>

                <!-- Faction profile, shown after registration. -->
                <BoxContainer Name="ProfileContainer" Orientation="Vertical" SeparationOverride="8" Visible="False">
                    <PanelContainer Name="HeaderPanel" HorizontalExpand="True" MinHeight="96">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <TextureRect Name="PhotoRect"
                                         MinSize="56 56"
                                         SetSize="56 56"
                                         Stretch="KeepAspectCentered"
                                         VerticalAlignment="Center"/>
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          VerticalAlignment="Center"
                                          SeparationOverride="3">
                                <Label Name="FactionNameLabel" StyleClasses="LabelBig" ClipText="True" FontColorOverride="#1e293b"/>
                                <Label Name="DescriptionLabel" StyleClasses="LabelSubText" FontColorOverride="#334155"/>
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                        <Button Name="CustomizationButton" Text="{Loc 'faction-computer-customize'}" HorizontalExpand="True" MinSize="0 26"/>
                        <Button Name="MembersButton" Text="{Loc 'faction-computer-members'}" HorizontalExpand="True" MinSize="0 26"/>
                        <Button Name="ProgressButton" Text="{Loc 'faction-computer-progress'}" HorizontalExpand="True" MinSize="0 26"/>
                    </BoxContainer>

                    <Label Name="OwnerNote" Text="{Loc 'faction-computer-not-leader'}" StyleClasses="LabelSubText" FontColorOverride="#334155" Visible="False"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Dark panel (right, narrower): faction list + browsing. -->
        <PanelContainer MinWidth="250" MaxWidth="290">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1e293b" BorderColor="#334155" BorderThickness="1" ContentMarginLeftOverride="8" ContentMarginRightOverride="8" ContentMarginTopOverride="8" ContentMarginBottomOverride="8"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" SeparationOverride="4">
                <Label Text="{Loc 'faction-computer-link-title'}" StyleClasses="LabelKeyText" FontColorOverride="#e2e8f0" Margin="0 0 0 2"/>

                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" MinHeight="120">
                    <BoxContainer Name="FactionListContainer"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  SeparationOverride="3"/>
                </ScrollContainer>

                <Label Name="NoFactionsLabel"
                       Text="{Loc 'faction-computer-no-factions'}"
                       StyleClasses="LabelSubText"
                       FontColorOverride="#94a3b8"
                       Visible="False"/>

                <!-- Detail view for a browsed faction. -->
                <BoxContainer Name="FactionDetailContainer" Orientation="Vertical" SeparationOverride="3" Visible="False" Margin="0 4 0 0">
                    <PanelContainer HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0f172a" BorderColor="#334155" BorderThickness="1" ContentMarginLeftOverride="6" ContentMarginRightOverride="6" ContentMarginTopOverride="4" ContentMarginBottomOverride="4"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="2">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                <TextureRect Name="DetailPhotoRect" MinSize="28 28" SetSize="28 28" Stretch="KeepAspectCentered" VerticalAlignment="Center"/>
                                <Label Name="DetailNameLabel" StyleClasses="LabelKeyText" FontColorOverride="#e2e8f0" ClipText="True" HorizontalExpand="True"/>
                            </BoxContainer>
                            <Label Name="DetailDescriptionLabel" StyleClasses="LabelSubText" FontColorOverride="#94a3b8"/>
                            <Label Name="DetailLeaderLabel" StyleClasses="LabelSubText" FontColorOverride="#94a3b8"/>
                            <Label Name="DetailMembersLabel" StyleClasses="LabelSubText" FontColorOverride="#94a3b8"/>
                            <BoxContainer Name="DetailMembersContainer" Orientation="Vertical" SeparationOverride="1" Margin="0 2 0 0"/>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>