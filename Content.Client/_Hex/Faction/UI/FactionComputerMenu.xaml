<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      SetSize="720 540"
                      MinSize="660 480">
    <BoxContainer Orientation="Horizontal" Margin="0" SeparationOverride="0">
        <!-- Light panel (left): creation + claimed faction profile. -->
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#d9e2ec" BorderColor="#b0bec5" BorderThickness="1"
                                  ContentMarginLeftOverride="16" ContentMarginRightOverride="16"
                                  ContentMarginTopOverride="14" ContentMarginBottomOverride="14"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" SeparationOverride="8">
                <Label Text="{Loc 'faction-computer-menu-title'}" StyleClasses="LabelBig"
                       FontColorOverride="#1e293b" Margin="0 0 0 4"/>

                <!-- Registration (before faction claimed). -->
                <BoxContainer Name="RegisterContainer" Orientation="Vertical" SeparationOverride="6">
                    <Label Text="{Loc 'faction-computer-register-hint'}" StyleClasses="LabelSubText"
                           FontColorOverride="#334155" Margin="0 0 0 2"/>
                    <Button Name="IdCardButton" Text="{Loc 'faction-computer-id-insert'}"
                            HorizontalExpand="True" MinSize="0 30" Margin="0 2"/>
                    <Label Name="IdCardStatus" Text="{Loc 'faction-computer-id-empty'}"
                           StyleClasses="LabelSubText" FontColorOverride="#334155" Margin="4 0 0 0"/>
                    <LineEdit Name="NameEdit" PlaceHolder="{Loc 'faction-computer-register-name'}"
                              HorizontalExpand="True" MinSize="0 30" Margin="0 2"/>
                    <Button Name="CreateButton" Text="{Loc 'faction-computer-register-create'}"
                            Disabled="True" HorizontalExpand="True" MinSize="0 32" Margin="0 4"/>
                    <Label Text="{Loc 'faction-computer-register-note'}" StyleClasses="LabelSubText"
                           FontColorOverride="#334155" Margin="4 4 0 0"/>
                </BoxContainer>

                <!-- Faction profile (after registration). -->
                <BoxContainer Name="ProfileContainer" Orientation="Vertical" SeparationOverride="10" Visible="False">
                    <PanelContainer Name="HeaderPanel" HorizontalExpand="True" MinHeight="100">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="12" Margin="10">
                            <TextureRect Name="PhotoRect"
                                         MinSize="64 64"
                                         Stretch="KeepAspectCentered"
                                         VerticalAlignment="Center"/>
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          VerticalAlignment="Center"
                                          SeparationOverride="4">
                                <Label Name="FactionNameLabel" StyleClasses="LabelBig"
                                       ClipText="True" FontColorOverride="#1e293b"/>
                                <Label Name="DescriptionLabel" StyleClasses="LabelSubText"
                                       FontColorOverride="#334155" ClipText="True"/>
                                <Label Name="BeaconCountLabel" StyleClasses="LabelSubText"
                                       FontColorOverride="#334155"/>
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 4">
                        <Button Name="CustomizationButton" Text="{Loc 'faction-computer-customize'}"
                                HorizontalExpand="True" MinSize="0 30"/>
                        <Button Name="MembersButton" Text="{Loc 'faction-computer-members'}"
                                HorizontalExpand="True" MinSize="0 30"/>
                        <Button Name="ProgressButton" Text="{Loc 'faction-computer-progress'}"
                                HorizontalExpand="True" MinSize="0 30"/>
                    </BoxContainer>

                    <Label Name="OwnerNote" Text="{Loc 'faction-computer-not-leader'}"
                           StyleClasses="LabelSubText" FontColorOverride="#334155" Visible="False"
                           Margin="4 0 0 0"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Dark panel (right): faction list + browsing. -->
        <PanelContainer MinWidth="260" MaxWidth="300">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1e293b" BorderColor="#334155" BorderThickness="1"
                                  ContentMarginLeftOverride="10" ContentMarginRightOverride="10"
                                  ContentMarginTopOverride="10" ContentMarginBottomOverride="10"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                <Label Text="{Loc 'faction-computer-link-title'}" StyleClasses="LabelKeyText"
                       FontColorOverride="#e2e8f0" Margin="0 0 0 4"/>

                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" MinHeight="140">
                    <BoxContainer Name="FactionListContainer"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  SeparationOverride="4"/>
                </ScrollContainer>

                <Label Name="NoFactionsLabel"
                       Text="{Loc 'faction-computer-no-factions'}"
                       StyleClasses="LabelSubText"
                       FontColorOverride="#94a3b8"
                       Visible="False"/>

                <!-- Detail view for a browsed faction. -->
                <BoxContainer Name="FactionDetailContainer" Orientation="Vertical" SeparationOverride="4"
                              Visible="False" Margin="0 6 0 0">
                    <PanelContainer HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0f172a" BorderColor="#334155" BorderThickness="1"
                                              ContentMarginLeftOverride="8" ContentMarginRightOverride="8"
                                              ContentMarginTopOverride="6" ContentMarginBottomOverride="6"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="3">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                <TextureRect Name="DetailPhotoRect" MinSize="32 32"
                                             Stretch="KeepAspectCentered" VerticalAlignment="Center"/>
                                <Label Name="DetailNameLabel" StyleClasses="LabelKeyText"
                                       FontColorOverride="#e2e8f0" ClipText="True" HorizontalExpand="True"/>
                            </BoxContainer>
                            <Label Name="DetailDescriptionLabel" StyleClasses="LabelSubText"
                                   FontColorOverride="#94a3b8" ClipText="True"/>
                            <Label Name="DetailLeaderLabel" StyleClasses="LabelSubText"
                                   FontColorOverride="#94a3b8"/>
                            <Label Name="DetailMembersLabel" StyleClasses="LabelSubText"
                                   FontColorOverride="#94a3b8"/>
                            <Label Name="DetailBeaconCountLabel" StyleClasses="LabelSubText"
                                   FontColorOverride="#94a3b8"/>
                            <BoxContainer Name="DetailMembersContainer" Orientation="Vertical"
                                          SeparationOverride="1" Margin="0 3 0 0"/>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
