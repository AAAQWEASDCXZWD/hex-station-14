<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="580 680"
                      MinSize="540 560">
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="10" HorizontalExpand="True">
            <Label Text="{Loc 'faction-customization-title'}" StyleClasses="LabelBig" Margin="0 0 0 4"/>

            <!-- Live profile preview. -->
            <PanelContainer Name="PreviewPanel" HorizontalExpand="True" MinHeight="110">
                <BoxContainer Orientation="Horizontal" SeparationOverride="12" Margin="12">
                    <TextureRect Name="PhotoRect"
                                 MinSize="64 64"
                                 MaxSize="96 96"
                                 Stretch="KeepAspectCentered"
                                 VerticalAlignment="Center"/>
                    <BoxContainer Orientation="Vertical"
                                  HorizontalExpand="True"
                                  VerticalAlignment="Center"
                                  SeparationOverride="4">
                        <Label Name="NamePreviewLabel" StyleClasses="LabelBig" ClipText="True"/>
                        <Label Name="DescriptionPreviewLabel" StyleClasses="LabelSubText" ClipText="True"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <Label Text="{Loc 'faction-customization-name'}" StyleClasses="LabelKeyText" Margin="0 4 0 0"/>
            <LineEdit Name="NameEdit" HorizontalExpand="True" MinSize="0 28"/>

            <Label Text="{Loc 'faction-customization-description'}" StyleClasses="LabelKeyText" Margin="0 4 0 0"/>
            <TextEdit Name="DescriptionEdit" HorizontalExpand="True" MinHeight="80"/>

            <Label Text="{Loc 'faction-customization-color'}" StyleClasses="LabelKeyText" Margin="0 4 0 0"/>
            <GridContainer Name="ColorGrid" Columns="6" HorizontalExpand="True"/>
            <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 2 0 0">
                <Label Text="RGB:" VerticalAlignment="Center" MinWidth="36"/>
                <LineEdit Name="ColorHexEdit" PlaceHolder="#FF00FF" HorizontalExpand="True" MinSize="0 28"/>
            </BoxContainer>

            <Label Text="{Loc 'faction-customization-photo'}" StyleClasses="LabelKeyText" Margin="0 4 0 0"/>
            <GridContainer Name="PhotoGrid" Columns="8" HorizontalExpand="True"/>
            <Button Name="UploadPhotoButton" Text="{Loc 'faction-customization-upload-photo'}"
                    HorizontalExpand="True" MinSize="0 30" Margin="0 2"/>
            <Label Name="PhotoStatusLabel" StyleClasses="LabelSubText" FontColorOverride="#64748b"
                   Text="" Visible="False" Margin="4 0 0 0"/>

            <Button Name="SaveButton" Text="{Loc 'faction-customization-save'}"
                    HorizontalExpand="True" MinSize="0 34" Margin="0 8 0 0"/>
        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
