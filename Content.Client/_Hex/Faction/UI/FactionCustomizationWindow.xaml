<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="560 640"
                      MinSize="520 520">
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8" HorizontalExpand="True">
            <Label Text="{Loc 'faction-customization-title'}" StyleClasses="LabelBig"/>

            <!-- Live profile preview. -->
            <PanelContainer Name="PreviewPanel" HorizontalExpand="True" MinHeight="120">
                <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                    <TextureRect Name="PhotoRect"
                                 MinSize="64 64"
                                 SetSize="64 64"
                                 Stretch="KeepAspectCentered"
                                 VerticalAlignment="Center"/>
                    <BoxContainer Orientation="Vertical"
                                  HorizontalExpand="True"
                                  VerticalAlignment="Center"
                                  SeparationOverride="4">
                        <Label Name="NamePreviewLabel" StyleClasses="LabelBig" ClipText="True"/>
                        <Label Name="DescriptionPreviewLabel" StyleClasses="LabelSubText"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <Label Text="{Loc 'faction-customization-name'}" StyleClasses="LabelKeyText"/>
            <LineEdit Name="NameEdit" HorizontalExpand="True"/>

            <Label Text="{Loc 'faction-customization-description'}" StyleClasses="LabelKeyText"/>
            <TextEdit Name="DescriptionEdit" HorizontalExpand="True" MinHeight="90"/>

            <Label Text="{Loc 'faction-customization-color'}" StyleClasses="LabelKeyText"/>
            <GridContainer Name="ColorGrid" Columns="6" HorizontalExpand="True"/>

            <Label Text="{Loc 'faction-customization-photo'}" StyleClasses="LabelKeyText"/>
            <GridContainer Name="PhotoGrid" Columns="8" HorizontalExpand="True"/>

            <Button Name="SaveButton" Text="{Loc 'faction-customization-save'}" HorizontalExpand="True" Margin="0 6 0 0"/>
        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
