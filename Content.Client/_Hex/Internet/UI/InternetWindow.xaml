<ui:InternetWindow xmlns="https://spacestation14.io"
                   xmlns:ui="clr-namespace:Content.Client._Hex.Internet.UI"
                   HorizontalExpand="True"
                   VerticalExpand="True">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  SeparationOverride="4">
        <BoxContainer Name="HeaderRow"
                      Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="4">
            <Button Name="BackButton" MinSize="30 26" Visible="False"/>
            <Label Name="HeaderTitle"
                   StyleClasses="LabelBig"
                   FontColorOverride="#7ff5e8"
                   HorizontalExpand="True"
                   ClipText="True"
                   VerticalAlignment="Center"/>
            <Button Name="FeedTab" MinSize="62 26"/>
            <Button Name="TopicsTab" MinSize="62 26"/>
        </BoxContainer>
        <Label Name="PathLabel"
               StyleClasses="LabelSubText"
               FontColorOverride="#5fa8a2"
               ClipText="True"/>
        <ScrollContainer Name="ContentScroll"
                         HorizontalExpand="True"
                         VerticalExpand="True"
                         HScrollEnabled="False">
            <BoxContainer Name="ContentContainer"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          SeparationOverride="4"/>
        </ScrollContainer>
        <BoxContainer Name="DarknetAliasRow"
                      Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="4"
                      Visible="False">
            <Label Name="DarknetAliasLabel"
                   StyleClasses="LabelSubText"
                   FontColorOverride="#5fa8a2"
                   VerticalAlignment="Center"/>
            <LineEdit Name="DarknetAliasEdit"
                      HorizontalExpand="True"
                      MinSize="0 24"/>
            <Button Name="DarknetAliasButton"
                    MinSize="0 24"/>
        </BoxContainer>
        <BoxContainer Name="FooterRow"
                      Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="4"
                      MinHeight="30">
            <Label Name="FooterLabel"
                   StyleClasses="LabelSubText"
                   FontColorOverride="#5fa8a2"
                   HorizontalExpand="True"
                   ClipText="True"
                   VerticalAlignment="Center"/>
            <Button Name="ComposeButton" MinSize="34 30"/>
        </BoxContainer>
    </BoxContainer>
</ui:InternetWindow>
