<DefaultWindow xmlns="https://spacestation14.io"
            Title="{Loc 'shuttle-id-card-console-window-title'}"
            MinSize="650 380">
    <BoxContainer Orientation="Vertical" Margin="4">
        <GridContainer Columns="3" HorizontalExpand="True">
            <Label Text="{Loc 'id-card-console-window-privileged-id'}" />
            <Button Name="PrivilegedIdButton" Access="Public" MinWidth="100"/>
            <Label Name="PrivilegedIdLabel" />

            <Label Text="{Loc 'id-card-console-window-target-id'}" />
            <Button Name="TargetIdButton" Access="Public" MinWidth="100"/>
            <Label Name="TargetIdLabel" />
        </GridContainer>

        <Control MinSize="0 8" />

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Text="{Loc 'shuttle-id-card-console-select-shuttle-label'}" Margin="0 0 8 0"/>
            <OptionButton Name="ShuttleSelectOptionButton" HorizontalExpand="True" />
            <Label Name="ShuttleRoleLabel" Margin="8 0 0 0" Modulate="Yellow" />
        </BoxContainer>

        <Control MinSize="0 4" />

        <BoxContainer Orientation="Vertical">
            <Label Name="TargetCardInfoLabel" Text="{Loc 'shuttle-id-card-console-no-target'}" />
            <Label Name="TargetOtherGroupsLabel" Modulate="LightGray" />
        </BoxContainer>

        <Control MinSize="0 8" />

        <ScrollContainer VerticalExpand="True" MinSize="0 180">
            <Control Name="AccessLevelControlContainer" />
        </ScrollContainer>

        <Control MinSize="0 8" />

        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="RemoveGroupButton"
                    Text="{Loc 'shuttle-id-card-console-remove-button'}"
                    Disabled="True"
                    Margin="0 0 8 0"/>
            <Button Name="SaveAccessButton"
                    Text="{Loc 'shuttle-id-card-console-save-button'}"
                    Disabled="True" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
