# Порти конвеєрних вузлів
signal-port-name-factory-conveyor-next-direction = Наступний напрямок
signal-port-description-factory-conveyor-next-direction = Перемикає активний вихідний напрямок цього конвеєрного вузла.

signal-port-name-factory-conveyor-direction-forward = Напрямок Вперед
signal-port-description-factory-conveyor-direction-forward = Встановлює вихідний напрямок конвеєрного вузла вперед.

signal-port-name-factory-conveyor-direction-right = Напрямок Праворуч
signal-port-description-factory-conveyor-direction-right = Встановлює вихідний напрямок конвеєрного вузла праворуч.

signal-port-name-factory-conveyor-direction-backward = Напрямок Назад
signal-port-description-factory-conveyor-direction-backward = Встановлює вихідний напрямок конвеєрного вузла назад.

signal-port-name-factory-conveyor-direction-left = Напрямок Ліворуч
signal-port-description-factory-conveyor-direction-left = Встановлює вихідний напрямок конвеєрного вузла ліворуч.

# Дієслова та спливаючі сповіщення конвеєрних вузлів
factory-conveyor-junction-verb-cycle = Перемкнути напрямок
factory-conveyor-junction-verb-set = Встановити напрямок: {$direction}
factory-conveyor-junction-switched = Конвеєр спрямовано: {$direction}

factory-conveyor-junction-dir-forward = Вперед
factory-conveyor-junction-dir-right = Праворуч
factory-conveyor-junction-dir-backward = Назад
factory-conveyor-junction-dir-left = Ліворуч

# Виготовничі точки (Tool Stations)
ent-FactoryToolStationWelder = зварювальний фабричний верстат
    .desc = Стаціонарний автоматичний маніпуляторний верстат, який виконує зварювальні операції над предметами перед ним.

ent-FactoryToolStationScrewdriver = викрутковий фабричний верстат
    .desc = Стаціонарний автоматичний маніпуляторний верстат, який закручує та відкручує кріплення на предметах перед ним.

ent-FactoryToolStationWirecutter = кусачковий фабричний верстат
    .desc = Стаціонарний автоматичний маніпуляторний верстат, який обрізає та обробляє проводку на предметах перед ним.

ent-FactoryToolStationCrowbar = монтувальний фабричний верстат
    .desc = Стаціонарний автоматичний маніпуляторний верстат, який підважує та відкриває панелі на предметах перед ним.

ent-FactoryToolStationWrench = гайковий фабричний верстат
    .desc = Стаціонарний автоматичний маніпуляторний верстат, який закручує та затягує болти на предметах перед ним.

# Конвеєрні вузли
ent-FactoryConveyorIntersection = конвеєрне перехрестя (4-way)
    .desc = Промислове конвеєрне перехрестя, здатне пересувати предмети в усі 4 сторони світу (одна активна сторона одночасно).

ent-FactoryConveyorTJunction = Т-подібний конвеєр
    .desc = Промисловий Т-подібний конвеєрний вузол, здатний пересувати предмети по прямій або повертати в праве відгалуження.

ent-FactoryConveyorTJunctionFlipped = Т-подібний конвеєр (лівий)
    .desc = Промисловий Т-подібний конвеєрний вузол, здатний пересувати предмети по прямій або повертати в ліве відгалуження.
