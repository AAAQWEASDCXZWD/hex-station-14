# Диск координат надсвіткового переходу
cmd-ftldisk-desc = Створити диск із координатами надсвіткового переходу до мапи, на якій розташована вказана сутність.
cmd-ftldisk-help = Використання: ftldisk [EntityID]

cmd-ftldisk-no-transform = У сутності {$destination} немає компонента Transform!
cmd-ftldisk-no-map = У сутності {$destination} немає мапи!
cmd-ftldisk-no-map-comp = Сутність {$destination} чомусь перебуває на мапі {$map}, але не має компонента мапи.
cmd-ftldisk-map-not-init = Сутність {$destination} перебуває на неініціалізованій мапі {$map}! Переконайтеся, що її безпечно ініціалізувати, і зробіть це, інакше гравці застрягнуть на місці!
cmd-ftldisk-map-paused = Сутність {$desintation} перебуває на призупиненій мапі {$map}! Спершу відновіть мапу, інакше гравці застрягнуть на місці.
cmd-ftldisk-planet = Сутність {$desintation} перебуває на планетарній мапі {$map}; для переходу потрібна точка надсвіткового переходу. Можливо, вона вже існує.
cmd-ftldisk-already-dest-not-enabled = Сутність {$destination} перебуває на мапі {$map} з компонентом FTLDestinationComponent, але він вимкнений! З міркувань безпеки увімкніть його вручну.
cmd-ftldisk-requires-ftl-point = Для переходу до мапи {$map}, на якій перебуває сутність {$destination}, потрібна точка надсвіткового переходу. Можливо, вона вже існує.

cmd-ftldisk-hint = Мережевий ID мапи
