## Інтерфейс

injector-draw-text = Набрати
injector-inject-text = Ввести
injector-invalid-injector-toggle-mode = Недійсний режим
injector-volume-label = Об'єм: [color=white]{$currentVolume}/{$totalVolume}[/color]
    Режим: [color=white]{$modeString}[/color] ([color=white]{$transferVolume} од.[/color])

## Сутність

injector-component-drawing-text = Набирає розчин
injector-component-injecting-text = Вводить розчин
injector-component-cannot-transfer-message = Не вдалося перенести розчин до {THE($target)}!
injector-component-cannot-draw-message = Не вдалося набрати розчин з {THE($target)}!
injector-component-cannot-inject-message = Не вдалося ввести розчин у {THE($target)}!
injector-component-inject-success-message = Ви вводите {$amount} од. розчину в {THE($target)}!
injector-component-transfer-success-message = Ви переносите {$amount} од. розчину в {THE($target)}.
injector-component-draw-success-message = Ви набираєте {$amount} од. розчину з {THE($target)}.
injector-component-target-already-full-message = {CAPITALIZE(THE($target))} уже повний!
injector-component-target-is-empty-message = {CAPITALIZE(THE($target))} порожній!
injector-component-cannot-toggle-draw-message = Не можна набрати — шприц майже повний!
injector-component-cannot-toggle-inject-message = Немає чого вводити!

## Повідомлення під час введення розчину в істоту

injector-component-drawing-user = Ви починаєте набирати розчин у шприц.
injector-component-injecting-user = Ви починаєте вводити розчин шприцом.
injector-component-drawing-target = {CAPITALIZE(THE($user))} намагається набрати у вас рідину шприцом!
injector-component-injecting-target = {CAPITALIZE(THE($user))} намагається вколоти вас шприцом!
