### Перенесення розчину

comp-solution-transfer-fill-normal = Ви наповнюєте {THE($target)} на {$amount} од. з {THE($owner)}.
comp-solution-transfer-fill-fully = Ви доверху наповнюєте {THE($target)} на {$amount} од. з {THE($owner)}.
comp-solution-transfer-transfer-solution = Ви переносите {$amount} од. розчину в {THE($target)}.

## Повідомлення, коли розчин не вдається перенести
comp-solution-transfer-is-empty = {CAPITALIZE(THE($target))} порожній!
comp-solution-transfer-is-full = {CAPITALIZE(THE($target))} повний!

## Вибір обсягу перенесення
comp-solution-transfer-verb-custom-amount = Власний
comp-solution-transfer-verb-amount = {$amount} од.
comp-solution-transfer-verb-toggle = Перемкнути на {$amount} од.

## Підтвердження нового обсягу перенесення
comp-solution-transfer-set-amount = Обсяг перенесення: {$amount} од.
comp-solution-transfer-set-amount-max = Максимум: {$amount} од.
comp-solution-transfer-set-amount-min = Мінімум: {$amount} од.
